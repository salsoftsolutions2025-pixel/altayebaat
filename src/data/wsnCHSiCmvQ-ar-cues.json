[
  {
    "start": 0,
    "end": 7.36,
    "text": "أعراض الأعراض"
  },
  {
    "start": 7.36,
    "end": 14.12,
    "text": "هو الأعراض بإنتصم في التابع الأعصابة الترفية للتفرن يروبسي"
  },
  {
    "start": 14.12,
    "end": 16.88,
    "text": "بإنتصم لأعراض حسية"
  },
  {
    "start": 16.88,
    "end": 20.84,
    "text": "دي لممكن لعين فيها يشتكي من شك شكة تنميل"
  },
  {
    "start": 20.84,
    "end": 26,
    "text": "ثلاث حرارة بأسعادية برودة سعادة حسيز القنية"
  },
  {
    "start": 26.08,
    "end": 28.76,
    "text": "ولكن في البرد لا يستحملش البرد"
  },
  {
    "start": 28.76,
    "end": 31.76,
    "text": "يعني دا سنسري أو بنسمي حسي"
  },
  {
    "start": 31.76,
    "end": 35.36,
    "text": "في ممكن موت رباتي رعشة رجافات بتي"
  },
  {
    "start": 35.36,
    "end": 38.52,
    "text": "ممكن ليه حاجة اتناميك باعة"
  },
  {
    "start": 38.52,
    "end": 42.72,
    "text": "أو اللي هو يعني لا إراضي ده ليه بيبقى التبول في الحظة متأخرة"
  },
  {
    "start": 42.72,
    "end": 46.88,
    "text": "لكن هي في البداية بتي الأعصابة الترفية نفسها بتتحرها"
  },
  {
    "start": 46.88,
    "end": 47.8,
    "text": "تمام"
  },
  {
    "start": 47.8,
    "end": 50.88,
    "text": "اللي الصباع"
  },
  {
    "start": 50.88,
    "end": 55.48,
    "text": "نور الجنيك باين هو مش عارفين يعني هو مش عارفين سبب وإي"
  },
  {
    "start": 55.56,
    "end": 57.48,
    "text": "وحتى احنا من عالجو الجنرل"
  },
  {
    "start": 57.48,
    "end": 59.24,
    "text": "جنرل يعني تسكريبشن"
  },
  {
    "start": 59.24,
    "end": 61,
    "text": "ما بنكتب حاجات عامة مش"
  },
  {
    "start": 61,
    "end": 63.4,
    "text": "مش حاجات خاصة بالموضوع"
  },
  {
    "start": 63.4,
    "end": 65.88,
    "text": "ومش عارفين سبب وبرده"
  },
  {
    "start": 65.88,
    "end": 69.92,
    "text": "التهاب العصاب الترفية ممكن لكم ان اعرضوا صداع المزمن"
  },
  {
    "start": 69.92,
    "end": 71.72,
    "text": "اللي بيبقى بصفة مستمرة"
  },
  {
    "start": 71.72,
    "end": 75.48,
    "text": "التهابات المزمن التي في بيبقى الأنفاية وتقوم بتقعم البعضية كما صداعه"
  },
  {
    "start": 75.48,
    "end": 78.08,
    "text": "حاجات دي كلها جايا يمين راجب اللي"
  },
  {
    "start": 78.08,
    "end": 80.72,
    "text": "حاجات منعية ومناحة يعني غزة"
  },
  {
    "start": 80.72,
    "end": 81.92,
    "text": "منعي تغزية"
  },
  {
    "start": 81.92,
    "end": 84.16,
    "text": "تصلح غزة تصلح الحيات اللي"
  }
]