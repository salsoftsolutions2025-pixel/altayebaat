[
  {
    "start": 0,
    "end": 3,
    "text": "صم المتقطة حل ولا وحش"
  },
  {
    "start": 3,
    "end": 6,
    "text": "نسألوا حل ونسألوا ملوش لازمة"
  },
  {
    "start": 6,
    "end": 10,
    "text": "صم المتقطة معنى انقطعك عن الأكل"
  },
  {
    "start": 10,
    "end": 13,
    "text": "عدد ساعات معاين ببدوه معاك"
  },
  {
    "start": 13,
    "end": 15,
    "text": "4 ساعات وبنتول 16 ساعات"
  },
  {
    "start": 15,
    "end": 18,
    "text": "نقدر نقول انه يوفر لك وقت عشان الجسم"
  },
  {
    "start": 18,
    "end": 20,
    "text": "يقدر يتخلص منفضلاته"
  },
  {
    "start": 20,
    "end": 22,
    "text": "يقدر يتشح نفسه"
  },
  {
    "start": 22,
    "end": 24,
    "text": "يعمل عميت ريسيت"
  },
  {
    "start": 24,
    "end": 27,
    "text": "ريسيت بتقل شوية وقت لعشر سواني"
  },
  {
    "start": 27,
    "end": 29,
    "text": "اللي بتطفي في يوم الراوتر"
  },
  {
    "start": 29,
    "end": 31,
    "text": "هم مدول عدد ساعات الصيام بتاعك"
  },
  {
    "start": 31,
    "end": 35,
    "text": "بتحاول تخالي الكابد يتخلص من الدهون الكومات"
  },
  {
    "start": 35,
    "end": 38,
    "text": "قوة والأسهم المتقطة يعتبر"
  },
  {
    "start": 38,
    "end": 40,
    "text": "العلاج الوحيد للكابد الدهوني"
  },
  {
    "start": 40,
    "end": 42,
    "text": "ما فيش حد في مصر يقدر يقول"
  },
  {
    "start": 42,
    "end": 45,
    "text": "اي معلق الكابد الدهوني يقل الصيام المتقطة"
  },
  {
    "start": 45,
    "end": 48,
    "text": "اللي بيساعد الكابد على التخلص"
  },
  {
    "start": 48,
    "end": 50,
    "text": "من المخزون اللي عنده"
  },
  {
    "start": 50,
    "end": 52,
    "text": "من النشة والدهون"
  },
  {
    "start": 52,
    "end": 53,
    "text": "والعضلات كذلك"
  },
  {
    "start": 53,
    "end": 55,
    "text": "وبعد شوية يحاول الكابد من مخزن"
  },
  {
    "start": 55,
    "end": 56,
    "text": "يحاولوا المصنع"
  },
  {
    "start": 56,
    "end": 58,
    "text": "يقدر يصنع منه بقى الهرمونات"
  },
  {
    "start": 58,
    "end": 59,
    "text": "للمقصوني"
  },
  {
    "start": 59,
    "end": 61,
    "text": "يقدر يصنع منه"
  },
  {
    "start": 61,
    "end": 63,
    "text": "البروتيلي لنا عايزه في عضلاتي"
  },
  {
    "start": 63,
    "end": 65,
    "text": "يقدر يصنع منه"
  },
  {
    "start": 65,
    "end": 67,
    "text": "الأدوية والكورتزون"
  },
  {
    "start": 67,
    "end": 69,
    "text": "اللي هي عالج أمرض المناع اللي عندي"
  },
  {
    "start": 69,
    "end": 71,
    "text": "الصيام"
  },
  {
    "start": 71,
    "end": 73,
    "text": "يلاج للحاجات اللي حاولت عليها"
  },
  {
    "start": 73,
    "end": 75,
    "text": "صام المتقطة هي عليك"
  },
  {
    "start": 75,
    "end": 76,
    "text": "أعرض الألام المفاصل"
  },
  {
    "start": 76,
    "end": 77,
    "text": "اللي ممكن أنش قصر فيبر ميالج"
  },
  {
    "start": 77,
    "end": 79,
    "text": "وحنا مش عارفين دي سببها"
  },
  {
    "start": 79,
    "end": 80,
    "text": "أعرض شبه الروماهتوين"
  },
  {
    "start": 80,
    "end": 82,
    "text": "أعرض شبه الحساسيات في الجل"
  },
  {
    "start": 82,
    "end": 84,
    "text": "كله صام المتقطة بحسينه"
  },
  {
    "start": 84,
    "end": 86,
    "text": "صوم صح"
  },
  {
    "start": 86,
    "end": 87,
    "text": "ويفتر صح"
  },
  {
    "start": 87,
    "end": 88,
    "text": "هتعالج جسمك صح"
  }
]