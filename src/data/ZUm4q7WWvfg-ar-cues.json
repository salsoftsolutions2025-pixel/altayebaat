[
  {
    "start": 0,
    "end": 4,
    "text": "كتير أول عام بيشتكي من المفاصل"
  },
  {
    "start": 4,
    "end": 8,
    "text": "كتير أول بيشتكي من ألام أسفل الزهر وأسفل الرأبة"
  },
  {
    "start": 8,
    "end": 11,
    "text": "كتير أول بيروح يستشير دكاتلة المخو الأعصاب"
  },
  {
    "start": 11,
    "end": 13,
    "text": "ويستشير دكاتلة الألم"
  },
  {
    "start": 13,
    "end": 15,
    "text": "يا جامعة أعرفوا حاجة"
  },
  {
    "start": 15,
    "end": 16,
    "text": "أنت عضموك ضعيف"
  },
  {
    "start": 16,
    "end": 19,
    "text": "عضموك بتشتكي من الألم منه من غير حاجة"
  },
  {
    "start": 19,
    "end": 21,
    "text": "حتى من غير الويت بيرنج"
  },
  {
    "start": 21,
    "end": 22,
    "text": "من غير ما تشيل حاجة"
  },
  {
    "start": 22,
    "end": 23,
    "text": "ليه؟"
  },
  {
    "start": 24,
    "end": 26,
    "text": "عضموك بتشتكي من الألم منه من غير حاجة"
  },
  {
    "start": 26,
    "end": 28,
    "text": "حتى من غير الويت بيرنج"
  },
  {
    "start": 28,
    "end": 29,
    "text": "من غير ما تشيل حاجة"
  },
  {
    "start": 29,
    "end": 30,
    "text": "ليه؟"
  },
  {
    "start": 30,
    "end": 32,
    "text": "فقل الجزبية على عضم ضعيف"
  },
  {
    "start": 32,
    "end": 36,
    "text": "بيعمل الفركشن ده"
  },
  {
    "start": 36,
    "end": 38,
    "text": "بيعمل احتكاك ده"
  },
  {
    "start": 38,
    "end": 40,
    "text": "بيخل العضم يلزق في بعضه"
  },
  {
    "start": 40,
    "end": 41,
    "text": "عشان كلاحنا مع السن"
  },
  {
    "start": 41,
    "end": 43,
    "text": "إحنا بنقصر في الطول"
  },
  {
    "start": 43,
    "end": 44,
    "text": "ليه؟"
  },
  {
    "start": 44,
    "end": 45,
    "text": "العضم مش كالسفايد"
  },
  {
    "start": 45,
    "end": 47,
    "text": "مفهوش بروتين ولا فيه كالسيام كوايز"
  },
  {
    "start": 47,
    "end": 49,
    "text": "ويتمين دي نائس"
  },
  {
    "start": 49,
    "end": 52,
    "text": "عضمنا بعمل زي الغضاريف"
  },
  {
    "start": 52,
    "end": 54,
    "text": "سهلي الضغط"
  },
  {
    "start": 54,
    "end": 55,
    "text": "سهلي اقصر"
  },
  {
    "start": 55,
    "end": 56,
    "text": "ويتظهر منه"
  },
  {
    "start": 56,
    "end": 57,
    "text": "اعراض الألم"
  },
  {
    "start": 57,
    "end": 58,
    "text": "ودي لازم"
  },
  {
    "start": 58,
    "end": 60,
    "text": "واني ايه دايما المستمر"
  },
  {
    "start": 60,
    "end": 61,
    "text": "موجود مع العيني بيشتكي من الألم"
  },
  {
    "start": 61,
    "end": 63,
    "text": "بايت من دي تلقي عنده نائس"
  },
  {
    "start": 63,
    "end": 64,
    "text": "يا جماعة"
  },
  {
    "start": 64,
    "end": 65,
    "text": "هم احتاجين لقوة عضمنا"
  },
  {
    "start": 65,
    "end": 67,
    "text": "قبل ما نعالج الألم"
  },
  {
    "start": 67,
    "end": 68,
    "text": "عالج السبب"
  },
  {
    "start": 68,
    "end": 70,
    "text": "يتعالج العرب"
  }
]