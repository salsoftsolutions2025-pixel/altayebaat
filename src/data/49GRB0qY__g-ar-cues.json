[
  {
    "start": 0,
    "end": 3.16,
    "text": "كثير يعرف أنواع ضايت أنا نفسي معرفها"
  },
  {
    "start": 3.16,
    "end": 5.4,
    "text": "وش حاجات فيها حرمان وحاجات ما فيها اش"
  },
  {
    "start": 5.4,
    "end": 7.36,
    "text": "حاجات بتلعب على تعدد واجبات"
  },
  {
    "start": 7.36,
    "end": 12.16,
    "text": "وسناكس في النص ووهو حاجات تانية بتلعب على كالرز بتعملو مع عجسمك"
  },
  {
    "start": 12.16,
    "end": 15.24,
    "text": "علاق انه ايلا بتدخل فيها بنزين"
  },
  {
    "start": 15.24,
    "end": 17.88,
    "text": "وبتطلع منها كالرز الكلام ده بالصح"
  },
  {
    "start": 17.88,
    "end": 20.52,
    "text": "ده ده تقول لي نسمنا مش مرض في حديثاته"
  },
  {
    "start": 20.52,
    "end": 24.32,
    "text": "هو عرض من ده من ده مرض اكبر من قدن نسمي سوء التغزاة والانتصاص"
  },
  {
    "start": 24.32,
    "end": 27.16,
    "text": "سوء التغزاة والانتصاص والدلاء المريض"
  },
  {
    "start": 27.32,
    "end": 29.32,
    "text": "مريض السمنا بيشتكي من اعرض تانية"
  },
  {
    "start": 29.32,
    "end": 31.48,
    "text": "اعتبرها نهام الهاشعي الوقا"
  },
  {
    "start": 31.48,
    "end": 33.08,
    "text": "زي تسقط الشعر"
  },
  {
    "start": 33.08,
    "end": 35.92,
    "text": "تلاقي عنده مشاكل في الاعصاب الطرفية"
  },
  {
    "start": 35.92,
    "end": 38.12,
    "text": "شكشكة وتنميل ورعشة"
  },
  {
    "start": 38.12,
    "end": 41.24,
    "text": "تلاقي عنده كابد دهني"
  },
  {
    "start": 41.24,
    "end": 43,
    "text": "والدكتور الاشاعي يقوله عادي"
  },
  {
    "start": 43,
    "end": 45.28,
    "text": "ده الموضوع ده موجود في مصر كلها"
  },
  {
    "start": 45.28,
    "end": 48.56,
    "text": "تلاقي عنده في نفس التوقيت مشاكل جهاز هدمي"
  },
  {
    "start": 48.56,
    "end": 50.56,
    "text": "سوء ارتجاع مريء وحمودة"
  },
  {
    "start": 50.56,
    "end": 51.8,
    "text": "او قولون عاصبي"
  },
  {
    "start": 51.8,
    "end": 53.76,
    "text": "وبيتعمل مع كل عرض من دول"
  },
  {
    "start": 53.76,
    "end": 55.08,
    "text": "علاق انه مرض منفصل"
  },
  {
    "start": 55.08,
    "end": 56.84,
    "text": "مع انه هو كله كله"
  },
  {
    "start": 56.84,
    "end": 59.24,
    "text": "تحتمرت كبير اسمه سوء التغزية"
  },
  {
    "start": 59.24,
    "end": 60.52,
    "text": "وسوء الانتصاص"
  },
  {
    "start": 60.52,
    "end": 61.44,
    "text": "معانا"
  },
  {
    "start": 61.44,
    "end": 63.72,
    "text": "حتى اقدر تتخلص من السمنا اللي عندك"
  },
  {
    "start": 63.72,
    "end": 65.44,
    "text": "وهاتكسب ساحة افضل"
  },
  {
    "start": 65.44,
    "end": 67.44,
    "text": "وتكسب الوزن الزيادة اللي عندك"
  }
]