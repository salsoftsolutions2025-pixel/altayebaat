[
  {
    "start": 0,
    "end": 8,
    "text": "نقصة ويتمين دي"
  },
  {
    "start": 8,
    "end": 14,
    "text": "نقصة ويتمين دي ده مصطلح انتشر الفترة الأخيرة دي"
  },
  {
    "start": 14,
    "end": 16,
    "text": "الناس كلها بتشتكي منه مش عارفين سببه"
  },
  {
    "start": 16,
    "end": 18,
    "text": "بيغبوا الصبلمن بتاعه"
  },
  {
    "start": 18,
    "end": 20,
    "text": "بيتحسن شواء المستوى"
  },
  {
    "start": 20,
    "end": 22,
    "text": "وبعد ما وقفوا الصبلمن"
  },
  {
    "start": 22,
    "end": 25,
    "text": "المستوى الويتمين دي في الدم يبدأ انزل تاني"
  },
  {
    "start": 25,
    "end": 27,
    "text": "نفس الأعرب يشتكو منها"
  },
  {
    "start": 27,
    "end": 29,
    "text": "قلام في العظامة طويلة"
  },
  {
    "start": 29,
    "end": 30,
    "text": "اللونبونز"
  },
  {
    "start": 30,
    "end": 32,
    "text": "قلام فأسفل العمود الفطري"
  },
  {
    "start": 32,
    "end": 34,
    "text": "الناس دي كله بيشتكي منه ويتمين دي"
  },
  {
    "start": 34,
    "end": 38,
    "text": "لازم يكون فاهم انه مشقته الأصلية في الكابد"
  },
  {
    "start": 38,
    "end": 40,
    "text": "لازم الكابد يتصلح الأول"
  },
  {
    "start": 40,
    "end": 43,
    "text": "لازم الكابد بتاعنا يستغل الكوليسترول"
  },
  {
    "start": 43,
    "end": 44,
    "text": "اللي بيوصله كويس"
  },
  {
    "start": 44,
    "end": 46,
    "text": "ما يتحبس شواء"
  },
  {
    "start": 46,
    "end": 48,
    "text": "الكابد يومين بيصنع"
  },
  {
    "start": 48,
    "end": 50,
    "text": "صبق 100 ملي جرام"
  },
  {
    "start": 50,
    "end": 51,
    "text": "كوليسترول"
  },
  {
    "start": 51,
    "end": 52,
    "text": "يعني ما كانوا عرم نحتاجوا"
  },
  {
    "start": 52,
    "end": 54,
    "text": "كوليسترول ليستخدمات كتيرة"
  },
  {
    "start": 54,
    "end": 55,
    "text": "اوي بجسمنا"
  },
  {
    "start": 55,
    "end": 56,
    "text": "تغلها كويس"
  },
  {
    "start": 56,
    "end": 57,
    "text": "ونعرف"
  },
  {
    "start": 57,
    "end": 58,
    "text": "نوظفة كويس"
  },
  {
    "start": 58,
    "end": 61,
    "text": "قبل ما نشتكي من أعراض الجنبية"
  },
  {
    "start": 61,
    "end": 62,
    "text": "ويتمين دي"
  },
  {
    "start": 62,
    "end": 63,
    "text": "عرب من أعراض"
  },
  {
    "start": 63,
    "end": 65,
    "text": "عدم سغيلك كوليسترول"
  },
  {
    "start": 65,
    "end": 66,
    "text": "كويس في اسمنا"
  }
]