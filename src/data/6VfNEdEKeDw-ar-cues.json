[
  {
    "start": 0,
    "end": 2,
    "text": "بتعاني من تصاقت شعار"
  },
  {
    "start": 2,
    "end": 4,
    "text": "مصر كلها بتعاني من تصاقت شعار"
  },
  {
    "start": 4,
    "end": 6,
    "text": "ما فيش مشكلة"
  },
  {
    "start": 6,
    "end": 8,
    "text": "حاولت يترك لترك قلدي"
  },
  {
    "start": 8,
    "end": 10,
    "text": "ها عنتي PRP"
  },
  {
    "start": 10,
    "end": 12,
    "text": "ها عنتي PLATLESS"
  },
  {
    "start": 12,
    "end": 14,
    "text": "بعدها بشوية MISOTHERAPY"
  },
  {
    "start": 14,
    "end": 16,
    "text": "ها عنتي من اكسديل"
  },
  {
    "start": 16,
    "end": 18,
    "text": "كل الكلام ده حل"
  },
  {
    "start": 18,
    "end": 20,
    "text": "بجيب نتيجة موقع ده"
  },
  {
    "start": 20,
    "end": 22,
    "text": "ويرجع يوقعتين"
  },
  {
    "start": 22,
    "end": 24,
    "text": "او عايز مو داومة"
  },
  {
    "start": 24,
    "end": 26,
    "text": "تصاقل الشعره أسلن"
  },
  {
    "start": 26,
    "end": 28,
    "text": "نقص غزن"
  },
  {
    "start": 28,
    "end": 30,
    "text": "من أشماء الجل"
  },
  {
    "start": 30,
    "end": 32,
    "text": "زال سكوالين والكل ستير"
  },
  {
    "start": 32,
    "end": 34,
    "text": "حلو ايه حلو النهائي"
  },
  {
    "start": 34,
    "end": 36,
    "text": "غزن"
  },
  {
    "start": 36,
    "end": 38,
    "text": "تصاقت شعره ما بتحلش بحاجات موقعات"
  },
  {
    "start": 38,
    "end": 40,
    "text": "او حاجات توبيكل"
  },
  {
    "start": 40,
    "end": 42,
    "text": "و هتلاقي نفسك لو بتعاني من المشكلة دي"
  },
  {
    "start": 42,
    "end": 44,
    "text": "هتعرف ان انت عندي كما تتعافل عصب"
  },
  {
    "start": 44,
    "end": 46,
    "text": "الطرفية"
  },
  {
    "start": 46,
    "end": 48,
    "text": "هتلاقي شكرا في ايديكي"
  },
  {
    "start": 48,
    "end": 50,
    "text": "تنميل"
  },
  {
    "start": 50,
    "end": 52,
    "text": "اميكي بتحس فيها ببرودة"
  },
  {
    "start": 52,
    "end": 54,
    "text": "او حرارة"
  },
  {
    "start": 54,
    "end": 56,
    "text": "ها عدم تحمل وأطرف المتلجة في الفشتة"
  },
  {
    "start": 56,
    "end": 58,
    "text": "اشن كده اللي بتعاني متزق الشعر"
  },
  {
    "start": 58,
    "end": 60,
    "text": "و عندها نفس الارض دي"
  },
  {
    "start": 60,
    "end": 62,
    "text": "محتاجة تعمل"
  },
  {
    "start": 62,
    "end": 64,
    "text": "نظام غزائي و بتمشي على حاجات معين"
  },
  {
    "start": 64,
    "end": 66,
    "text": "حاجات هتمنحها و حاجات هتزود"
  }
]