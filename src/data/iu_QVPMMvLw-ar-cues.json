[
  {
    "start": 0,
    "end": 5,
    "text": "الناس اللي بتكلم في التخزية نوعين عدداً"
  },
  {
    "start": 5,
    "end": 7,
    "text": "يأطبق ذكاترة"
  },
  {
    "start": 7,
    "end": 11,
    "text": "إما ممرسين أو لو ما بيسمعوا صمخ براء"
  },
  {
    "start": 11,
    "end": 13,
    "text": "دوعدها بأجدك تود"
  },
  {
    "start": 13,
    "end": 15,
    "text": "مع الدكليومة مثلاً من المكان"
  },
  {
    "start": 15,
    "end": 18,
    "text": "ويكلم في الأكل"
  },
  {
    "start": 18,
    "end": 20,
    "text": "والتسكريبشنز أو شتات"
  },
  {
    "start": 20,
    "end": 22,
    "text": "وأدوية وكورسات"
  },
  {
    "start": 22,
    "end": 25,
    "text": "ولك حاجاتهم بصراحة من وضعت الصحة"
  },
  {
    "start": 25,
    "end": 27,
    "text": "وأي معلى"
  },
  {
    "start": 27,
    "end": 29,
    "text": "درسات أو أبحث"
  },
  {
    "start": 29,
    "end": 30,
    "text": "إحنا يعني ما سمعناش عنها"
  },
  {
    "start": 30,
    "end": 33,
    "text": "حتى الحاجات دي مجددا"
  },
  {
    "start": 33,
    "end": 37,
    "text": "ناس بتكلم في الحيمة الجزائية والغزة"
  },
  {
    "start": 37,
    "end": 40,
    "text": "ومثلاً كبات في جم"
  },
  {
    "start": 40,
    "end": 42,
    "text": "دوما اللي بيدو الحيمة الجزائية"
  },
  {
    "start": 42,
    "end": 43,
    "text": "للناس الراضيين عندهم"
  },
  {
    "start": 43,
    "end": 45,
    "text": "اللي زيادت مثلاً المبوض العضل"
  },
  {
    "start": 45,
    "end": 49,
    "text": "أو زيادت القدرة على التمرين"
  },
  {
    "start": 49,
    "end": 51,
    "text": "الناس دي ممكن تكلم في الترزية"
  },
  {
    "start": 51,
    "end": 53,
    "text": "بس ماش على أساس علمية"
  },
  {
    "start": 53,
    "end": 55,
    "text": "أو الأساس قبي"
  },
  {
    "start": 55,
    "end": 57,
    "text": "كالكريشنز"
  },
  {
    "start": 57,
    "end": 58,
    "text": "كالرس دقلة"
  },
  {
    "start": 58,
    "end": 59,
    "text": "كالرس خرجة"
  },
  {
    "start": 59,
    "end": 61,
    "text": "بنجمع بنطرح بنقسم"
  },
  {
    "start": 61,
    "end": 63,
    "text": "وإحنا ماشين في نفس الاريانج"
  },
  {
    "start": 63,
    "end": 64,
    "text": "زود بروتين"
  },
  {
    "start": 64,
    "end": 65,
    "text": "قل النشويات"
  },
  {
    "start": 65,
    "end": 67,
    "text": "بيضل ماشي معك بنفس الشكل"
  },
  {
    "start": 69,
    "end": 71,
    "text": "ملوش دعوة استجابت جسم مربع"
  },
  {
    "start": 71,
    "end": 73,
    "text": "ما يعرف شوية حكم فيها أو يسأل"
  },
  {
    "start": 73,
    "end": 74,
    "text": "أو"
  },
  {
    "start": 74,
    "end": 76,
    "text": "أعراض المصحبة للسمنة"
  },
  {
    "start": 76,
    "end": 78,
    "text": "ياتت حسن ولا بتسوق"
  },
  {
    "start": 78,
    "end": 80,
    "text": "يعني مهو كل مريد"
  },
  {
    "start": 80,
    "end": 81,
    "text": "عنه شوية السمنة"
  },
  {
    "start": 81,
    "end": 83,
    "text": "لازم يكون عنه أعراض تانية"
  },
  {
    "start": 83,
    "end": 85,
    "text": "لأنه بقالوا سنين بيشتفن"
  },
  {
    "start": 85,
    "end": 87,
    "text": "فهي لديه ارتجاع مريحة"
  },
  {
    "start": 87,
    "end": 89,
    "text": "لديه قولون عاصمي"
  },
  {
    "start": 89,
    "end": 91,
    "text": "حتى عنده بعد شوية ارتفاع"
  },
  {
    "start": 91,
    "end": 92,
    "text": "وضغط الدم"
  },
  {
    "start": 92,
    "end": 94,
    "text": "وارتفاع في نسبة للسبول في الدم"
  },
  {
    "start": 94,
    "end": 96,
    "text": "حاجات دي كلها تحسن"
  },
  {
    "start": 96,
    "end": 98,
    "text": "طبعا لديها تحسن مع"
  },
  {
    "start": 98,
    "end": 100,
    "text": "خبير التقزية"
  },
  {
    "start": 100,
    "end": 102,
    "text": "هو أصلا مش بيطبح"
  },
  {
    "start": 102,
    "end": 104,
    "text": "إستشارة التقزية"
  },
  {
    "start": 104,
    "end": 106,
    "text": "والطبيب أو الدكتور هو اللي يقدر"
  },
  {
    "start": 106,
    "end": 108,
    "text": "أو عنده تولز اللي يقدر يتبع بيها حاجة زيكة"
  },
  {
    "start": 109,
    "end": 110,
    "text": "لكن"
  },
  {
    "start": 110,
    "end": 112,
    "text": "كابتن الجيمة برضو ماشي بنفس السيكو"
  },
  {
    "start": 112,
    "end": 113,
    "text": "نحن نزود بروتين"
  },
  {
    "start": 113,
    "end": 114,
    "text": "لأكل عشخص لها عضلات"
  },
  {
    "start": 115,
    "end": 117,
    "text": "نمنعنا شويات عشخص لها"
  },
  {
    "start": 117,
    "end": 119,
    "text": "ندي قدوية نزود حرق"
  },
  {
    "start": 119,
    "end": 121,
    "text": "نلعب كاردي وهكذا"
  },
  {
    "start": 121,
    "end": 122,
    "text": "يعني"
  },
  {
    "start": 122,
    "end": 123,
    "text": "بلانت سبتها"
  },
  {
    "start": 126,
    "end": 128,
    "text": "الفلير فيها عالي"
  },
  {
    "start": 130,
    "end": 132,
    "text": "مش هل نقدر بنقول إنه ياما فاشن نجاح"
  },
  {
    "start": 132,
    "end": 133,
    "text": "لأ فيها نجاح بس نجاح"
  },
  {
    "start": 133,
    "end": 135,
    "text": "بتحصل الأرض الحمد للتلم عليها"
  },
  {
    "start": 135,
    "end": 136,
    "text": "لأنه ما مش عارفتني إنه يقصة أصلا"
  },
  {
    "start": 136,
    "end": 137,
    "text": "نصوء نصوء"
  },
  {
    "start": 137,
    "end": 138,
    "text": "يعني"
  },
  {
    "start": 138,
    "end": 139,
    "text": "والموضوع ده طبعا بحكي"
  },
  {
    "start": 139,
    "end": 140,
    "text": "يعني"
  },
  {
    "start": 140,
    "end": 141,
    "text": "وقايم على هرمونز"
  },
  {
    "start": 141,
    "end": 143,
    "text": "وقايم على مصنع كاملة"
  },
  {
    "start": 143,
    "end": 145,
    "text": "وستم كامل مدع"
  },
  {
    "start": 145,
    "end": 146,
    "text": "تقدر تتخبق عليها"
  },
  {
    "start": 146,
    "end": 148,
    "text": "ما يفهم عشغل دكتو طبيب"
  },
  {
    "start": 148,
    "end": 149,
    "text": "يعني"
  },
  {
    "start": 149,
    "end": 151,
    "text": "وده لحمد سبيل السيشرية"
  }
]