  {
    "start": 250.84,
    "end": 251.84,
    "text": "بيزعوص"
  },
  {
    "start": 251.84,
    "end": 252.84,
    "text": "مش قادر يكمل"
  },
  {
    "start": 252.84,
    "end": 253.84,
    "text": "ضرقم واحد"
  },
  {
    "start": 253.84,
    "end": 255.84,
    "text": "ساعة تانية تلاقي لقا"
  },
  {
    "start": 255.84,
    "end": 257.84,
    "text": "دا معاقا بجاز المناح نفسه"
