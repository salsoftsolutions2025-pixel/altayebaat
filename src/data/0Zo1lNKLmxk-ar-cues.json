[
  {
    "start": 0,
    "end": 13,
    "text": "سكر كمرض مزمن ومعظم أفكرنا عنه لو أنه ألتانياً"
  },
  {
    "start": 13,
    "end": 19,
    "text": "بنعتبروا مرض مزمن والإلاج منه صعب وإحنا التوارس لأنه نكمل علي إلاج لحد ما"
  },
  {
    "start": 19,
    "end": 22,
    "text": "يعني بتظل ونجليفين لكن لقى"
  },
  {
    "start": 22,
    "end": 24,
    "text": "الكلام دا مرصح"
  },
  {
    "start": 25,
    "end": 30,
    "text": "دا نوصل بها الجرعات ألب كتير من الأدوية حتى موقفنا خمس"
  },
  {
    "start": 30,
    "end": 33,
    "text": "بقلها سنين هو العشوة وفم السرحة والسلام"
  },
  {
    "start": 33,
    "end": 36,
    "text": "ممكن لها المشكلة في هذه القطعة"
  },
  {
    "start": 36,
    "end": 39,
    "text": "بس هو السكر زي أمرض تانية كتير"
  },
  {
    "start": 39,
    "end": 46,
    "text": "زي الضخط مثلا أو نرفع الضخط أو أمرض الألب أو السمنة"
  },
  {
    "start": 46,
    "end": 52,
    "text": "حاجات دي كلها زي السكر لازم يكلها أعرض منبها أبديها"
  },
  {
    "start": 52,
    "end": 57,
    "text": "إلي عيان سكر من النوع التاني لازم يكون عنده حاجة من فينيا"
  },
  {
    "start": 57,
    "end": 60,
    "text": "ارتجاع مريئة قولون عاصل برقم واحد برقم اتنين"
  },
  {
    "start": 60,
    "end": 62,
    "text": "أعرض سقل منتسورس"
  },
  {
    "start": 62,
    "end": 66,
    "text": "ضيطة مندي دايما تقليل عنده أنمية أو سستة من الانمية"
  },
  {
    "start": 66,
    "end": 69,
    "text": "حصل لها واحدة ستة وصبق لها الولادة وكتير"
  },
  {
    "start": 69,
    "end": 73,
    "text": "حاجات دي كلها أفضل أعرض سبقة لأعرض سكر مصر"
  },
  {
    "start": 73,
    "end": 77,
    "text": "قبل ما نقول بقى عطش كتير وتكل حمام كتير"
  },
  {
    "start": 77,
    "end": 79,
    "text": "وفقدان وزنة البداية لأ"
  },
  {
    "start": 79,
    "end": 80,
    "text": "قبل الكلام دي كله"
  },
  {
    "start": 80,
    "end": 81,
    "text": "فيه أعرض تاني"
  },
  {
    "start": 81,
    "end": 83,
    "text": "ارتجاع مريئة قولون عاصل"
  },
  {
    "start": 83,
    "end": 84,
    "text": "لازم يكون يومي"
  },
  {
    "start": 84,
    "end": 86,
    "text": "طبعا هو العام اللي ورصية لها تأسير"
  },
  {
    "start": 86,
    "end": 88,
    "text": "لكن إحنا ساعات من بلغ تأسيرها"
  },
  {
    "start": 88,
    "end": 91,
    "text": "ومن وقدم زواهر مش قدرنا تصور"
  },
  {
    "start": 91,
    "end": 93,
    "text": "فبنا نقول ده عامل ورصي"
  },
  {
    "start": 93,
    "end": 95,
    "text": "يعني لو قالك في العيادة عيان سكر"
  },
  {
    "start": 95,
    "end": 96,
    "text": "أو عيان ضخ"
  },
  {
    "start": 96,
    "end": 97,
    "text": "أول سؤال دي سألوك"
  },
  {
    "start": 97,
    "end": 100,
    "text": "حد في العيلة عنده سكر أو ضخ"
  },
  {
    "start": 100,
    "end": 102,
    "text": "معينا نشاهدنا السؤال ده في حد"
  },
  {
    "start": 102,
    "end": 103,
    "text": "زي تحنا مقل نشيل وليل"
  },
  {
    "start": 103,
    "end": 105,
    "text": "إنه أكثر ما بيورصولنا"
  },
  {
    "start": 105,
    "end": 106,
    "text": "جينات ورصية"
  },
  {
    "start": 106,
    "end": 107,
    "text": "يعني على مضرأة جيلة"
  },
  {
    "start": 107,
    "end": 109,
    "text": "لا أو ورصولك حد"
  },
  {
    "start": 109,
    "end": 111,
    "text": "عدات مش صح"
  },
  {
    "start": 111,
    "end": 112,
    "text": "إحنا تورصنا ما"
  },
  {
    "start": 112,
    "end": 113,
    "text": "تورص نفس الأمواض"
  },
  {
    "start": 113,
    "end": 114,
    "text": "نفس الشكل"
  },
  {
    "start": 114,
    "end": 116,
    "text": "نفس الطايمين"
  },
  {
    "start": 116,
    "end": 117,
    "text": "متوسل سنة معينة"
  },
  {
    "start": 117,
    "end": 118,
    "text": "تلقى عراضي"
  },
  {
    "start": 118,
    "end": 119,
    "text": "بدأت تظهر عنك"
  },
  {
    "start": 119,
    "end": 120,
    "text": "تظهر بدري شوية"
  },
  {
    "start": 120,
    "end": 121,
    "text": "إحنا انت بدأت القصة بدري شوية"
  },
  {
    "start": 121,
    "end": 123,
    "text": "بيعدات وحشة"
  },
  {
    "start": 123,
    "end": 125,
    "text": "من ورصة أكثر من جينات ومن وص"
  },
  {
    "start": 125,
    "end": 126,
    "text": "طبعا"
  },
  {
    "start": 126,
    "end": 128,
    "text": "قبل ما تكلم في التصيل"
  },
  {
    "start": 128,
    "end": 130,
    "text": "إحنا على طول الخط"
  },
  {
    "start": 130,
    "end": 132,
    "text": "طبعا قبل ما تكلم"
  },
  {
    "start": 132,
    "end": 134,
    "text": "إن حكتين"
  },
  {
    "start": 134,
    "end": 136,
    "text": "بزورو مرض السكر"
  },
  {
    "start": 136,
    "end": 137,
    "text": "وسبافة مرض السنة"
  },
  {
    "start": 137,
    "end": 138,
    "text": "وصفاعة كوليسترول"
  },
  {
    "start": 138,
    "end": 139,
    "text": "صندوق الشغيي"
  },
  {
    "start": 139,
    "end": 141,
    "text": "وصفاعة بردم"
  },
  {
    "start": 141,
    "end": 142,
    "text": "حكتين"
  },
  {
    "start": 142,
    "end": 143,
    "text": "أساسيين"
  },
  {
    "start": 143,
    "end": 144,
    "text": "مش بني تنزل عنهم"
  },
  {
    "start": 144,
    "end": 145,
    "text": "محبوزات"
  },
  {
    "start": 145,
    "end": 146,
    "text": "بدية الأبيض"
  },
  {
    "start": 146,
    "end": 147,
    "text": "النقي"
  },
  {
    "start": 147,
    "end": 148,
    "text": "رقم واحد"
  },
  {
    "start": 148,
    "end": 149,
    "text": "رقم اتنين"
  },
  {
    "start": 149,
    "end": 150,
    "text": "ومشبكة للأزياء"
  },
  {
    "start": 150,
    "end": 152,
    "text": "هناك حاجة أكثر من دولي دروب"
  },
  {
    "start": 152,
    "end": 153,
    "text": "درقم واحد"
  },
  {
    "start": 153,
    "end": 154,
    "text": "رقم اتنين"
  },
  {
    "start": 154,
    "end": 155,
    "text": "على مضاربا"
  },
  {
    "start": 155,
    "end": 156,
    "text": "أو على المستوى"
  },
  {
    "start": 156,
    "end": 157,
    "text": "العلمي"
  },
  {
    "start": 157,
    "end": 158,
    "text": "والدرسات العلمية"
  },
  {
    "start": 158,
    "end": 159,
    "text": "بيأسموا"
  },
  {
    "start": 159,
    "end": 160.04,
    "text": "لا"
  },
  {
    "start": 160.04,
    "end": 161.04,
    "text": "حصل على اندكس"
  },
  {
    "start": 161.04,
    "end": 163,
    "text": "بسم الله يسميك اندكس"
  },
  {
    "start": 163,
    "end": 164,
    "text": "عندما ترفعال السكر"
  },
  {
    "start": 164,
    "end": 165,
    "text": "في مسبوى الدقيقة"
  },
  {
    "start": 165,
    "end": 166,
    "text": "كاك"
  },
  {
    "start": 166,
    "end": 167,
    "text": "كاك"
  },
  {
    "start": 167,
    "end": 168,
    "text": "كاك"
  },
  {
    "start": 168,
    "end": 169,
    "text": "كاريسي بي"
  },
  {
    "start": 169,
    "end": 170,
    "text": "يعني كاواصفة"
  },
  {
    "start": 170,
    "end": 171,
    "text": "كزقي"
  },
  {
    "start": 171,
    "end": 172,
    "text": "ترفعال سكر الدقيقة"
  },
  {
    "start": 172,
    "end": 173,
    "text": "فبيأسموها"
  },
  {
    "start": 173,
    "end": 175,
    "text": "فمثلا بيحاطو"
  },
  {
    "start": 175,
    "end": 176,
    "text": "أن الشاويات كلها"
  },
  {
    "start": 176,
    "end": 177,
    "text": "أولي بيسموها"
  },
  {
    "start": 177,
    "end": 178,
    "text": "نشوات like روزول"
  },
  {
    "start": 178,
    "end": 179,
    "text": "مقارنا"
  },
  {
    "start": 179,
    "end": 180,
    "text": "والايش"
  },
  {
    "start": 180,
    "end": 181,
    "text": "والكلام"
  },
  {
    "start": 181,
    "end": 182,
    "text": "دأ كلو كلكتيجري"
  },
  {
    "start": 182,
    "end": 183,
    "text": "بيحاطو المخضرات"
  },
  {
    "start": 183,
    "end": 184,
    "text": "كلكتيجري"
  },
  {
    "start": 184,
    "end": 185,
    "text": "فطبعا"
  },
  {
    "start": 185,
    "end": 186,
    "text": "الحاجات الأقل كالرز"
  },
  {
    "start": 186,
    "end": 187,
    "text": "هي الأقلة"
  },
  {
    "start": 187,
    "end": 190.48,
    "text": "فطبعاً الكلام ده كله بيضور ده بارضه حوالين كالغريز"
  },
  {
    "start": 190.48,
    "end": 191.96,
    "text": "صعرات دخلة صعرات خرق"
  },
  {
    "start": 191.96,
    "end": 194.04,
    "text": "وذا مش ده الكونسيب تلعب ده نصف"
  },
  {
    "start": 194.04,
    "end": 194.8,
    "text": "الكونسيب تلعب ده نا"
  },
  {
    "start": 194.8,
    "end": 198,
    "text": "اوه فيه اكلات فيه حاجات عادت بنعملها"
  },
  {
    "start": 198,
    "end": 201,
    "text": "مش صح اوه مغبوزات ده اوه بيضط المشغولة"
  },
  {
    "start": 202.24,
    "end": 204,
    "text": "بس هو طبعاً"
  },
  {
    "start": 204,
    "end": 206.68,
    "text": "الوقت ان ده مريد سكر ومنعته الم يدغيره"
  },
  {
    "start": 206.68,
    "end": 207.84,
    "text": "اوه ده حقيقة طبعاً"
  },
  {
    "start": 207.84,
    "end": 209.84,
    "text": "بس ميش عاشه خطر فهو مريد سكر"
  },
  {
    "start": 209.84,
    "end": 212.84,
    "text": "هو المنعته بتقلم من بداية"
  },
  {
    "start": 212.84,
    "end": 216.84,
    "text": "من نشوق المرض او نشقت المرض بشهزور الاعرض او تشتيزه"
  },
  {
    "start": 216.84,
    "end": 221.84,
    "text": "بمعنى انه هو عشه خاص اقاطر اصلا مو مريد صوء امتصاص"
  },
  {
    "start": 221.84,
    "end": 224.84,
    "text": "والكابل بتاعه باقي فيه مشاكل في التصميع"
  },
  {
    "start": 224.84,
    "end": 227.84,
    "text": "هو مش قادر يتعمل مع السكر"
  },
  {
    "start": 227.84,
    "end": 228.84,
    "text": "برقم واحي"
  },
  {
    "start": 228.84,
    "end": 229.84,
    "text": "بس رقم ام اتنين"
  },
  {
    "start": 229.84,
    "end": 230.84,
    "text": "زي ما تريد صوء امتصاص"
  },
  {
    "start": 230.84,
    "end": 232.84,
    "text": "ما فيش امان واسيب واسيب"
  },
  {
    "start": 232.84,
    "end": 234.84,
    "text": "فيش فاتي اسدز معايانا بتوصل"
  },
  {
    "start": 234.84,
    "end": 236.84,
    "text": "يهزي المناعك دايماً"
  },
  {
    "start": 236.84,
    "end": 238.84,
    "text": "يبقى سويت شد اون"
  },
  {
    "start": 238.84,
    "end": 239.84,
    "text": "بالاكل ابتاعك"
  },
  {
    "start": 239.84,
    "end": 241.84,
    "text": "فيخلي دايماً منهك"
  },
  {
    "start": 241.84,
    "end": 242.84,
    "text": "تعبان"
  },
  {
    "start": 242.84,
    "end": 244.84,
    "text": "انت كل شوية بتديله غزة مش مظبوط"
  },
  {
    "start": 244.84,
    "end": 247.84,
    "text": "يتعرف عليه ده سليم مش سليم"
  },
  {
    "start": 247.84,
    "end": 248.84,
    "text": "يبقى سويت شد اون مش فا بسطبان"
